---
interface Props {
  heading?: string;
  subtext?: string;
  variant?: 'default' | 'inline';
}

const {
  heading = 'Join the Remnant',
  subtext = 'Prophetic writing delivered to those who refuse to look away. No spam. Unsubscribe anytime.',
  variant = 'default',
} = Astro.props;
---

<section class:list={[
  variant === 'default' ? 'section-padding bg-charcoal' : '',
]}>
  <div class="container mx-auto px-6 text-center max-w-2xl">
    <h2 class="mb-4">{heading}</h2>
    <div class="divider mx-auto mb-6"></div>
    <p class="text-muted text-lg leading-relaxed mb-8">{subtext}</p>

    <div class="w-full max-w-[560px] mx-auto">
      <script async src="https://subscribe-forms.beehiiv.com/embed.js"></script>
      <iframe src="https://subscribe-forms.beehiiv.com/c3ad021c-2a0f-40d3-9b52-2058dd05b6a5" class="beehiiv-embed" data-test-id="beehiiv-embed" frameborder="0" scrolling="no"></iframe>
    </div>
  </div>
</section>

<style>
  .beehiiv-embed {
    width: 100%;
    max-width: 560px;
    height: 420px;
    margin: 0;
    border-radius: 0 !important;
    background-color: transparent;
    box-shadow: none;
  }
  @media (min-width: 400px) {
    .beehiiv-embed {
      height: 340px;
    }
  }
  @media (min-width: 480px) {
    .beehiiv-embed {
      height: 291px;
    }
  }
</style>
