---
interface Props {
  heading?: string;
  subtext?: string;
  variant?: 'default' | 'inline';
}

const {
  heading = 'Join the Remnant',
  subtext = 'New essays, podcast episodes, and resources — delivered when they matter. No spam. Unsubscribe anytime.',
  variant = 'default',
} = Astro.props;
---

<section class:list={[
  variant === 'default' ? 'section-padding bg-charcoal' : '',
]}>
  <div class="container mx-auto px-6 text-center max-w-2xl">
    <h2 class="mb-4">{heading}</h2>
    <div class="divider mx-auto mb-6"></div>
    <p class="text-muted text-lg leading-relaxed mb-10">{subtext}</p>

    <form class="flex flex-col sm:flex-row gap-3 max-w-lg mx-auto" data-email-form>
      <input
        type="email"
        placeholder="Enter your email"
        required
        class="flex-1 px-5 py-4 bg-black border border-cream/10 text-cream placeholder:text-muted focus:outline-none focus:border-red transition-colors text-sm"
      />
      <button type="submit" class="btn-primary whitespace-nowrap">
        Subscribe
      </button>
    </form>

    <p class="text-muted/50 text-xs mt-4">We respect your inbox. Unsubscribe anytime.</p>
  </div>
</section>
