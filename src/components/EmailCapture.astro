---
interface Props {
  heading?: string;
  subtext?: string;
  variant?: 'default' | 'inline';
}

const {
  heading = 'Join the Remnant',
  subtext = 'Prophetic writing delivered to those who refuse to look away. No spam. Unsubscribe anytime.',
  variant = 'default',
} = Astro.props;
---

<section class:list={[
  variant === 'default' ? 'section-padding bg-charcoal' : '',
]}>
  <div class="container mx-auto px-6 text-center max-w-2xl">
    <h2 class="mb-4">{heading}</h2>
    <div class="divider mx-auto mb-6"></div>
    <p class="text-muted text-lg leading-relaxed mb-8">{subtext}</p>

    <div class="flex justify-center">
      <form
        action="https://app.beehiiv.com/subscribe"
        method="POST"
        target="_blank"
        class="beehiiv-form"
      >
        <input type="hidden" name="publication_id"
          value="c3ad021c-2a0f-40d3-9b52-2058dd05b6a5" />
        <input
          type="email"
          name="email"
          placeholder="Enter your email"
          required
          class="beehiiv-input"
        />
        <button type="submit" class="beehiiv-btn">Subscribe</button>
      </form>
    </div>
  </div>
</section>

<style>
  .beehiiv-form {
    display: flex;
    width: 100%;
    max-width: 560px;
    margin: 0 auto;
  }
  .beehiiv-input {
    flex: 1;
    min-width: 0;
    padding: 14px 16px;
    background: #1A1A1A;
    border: 1px solid #333;
    border-right: none;
    color: #F5F0E8;
    font-family: Inter, sans-serif;
    font-size: 14px;
    outline: none;
  }
  .beehiiv-btn {
    padding: 14px 24px;
    background: #B41E1E;
    color: #F5F0E8;
    border: none;
    font-family: Inter, sans-serif;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
  }
</style>
