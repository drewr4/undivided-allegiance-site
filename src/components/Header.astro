---
import { NAV_LINKS, SITE } from '../data/site-config';

const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300" id="site-header">
  <div class="relative z-[70] container mx-auto px-6 flex items-center justify-between h-20">
    <a href="/" class="font-heading text-xl font-bold tracking-tight text-cream hover:text-red transition-colors">
      {SITE.title}
    </a>

    <nav class="hidden lg:flex items-center gap-8" aria-label="Main navigation">
      {NAV_LINKS.map((link) => (
        <a
          href={link.href}
          class:list={[
            'text-sm font-medium uppercase tracking-widest transition-colors duration-200',
            currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
              ? 'text-red'
              : 'text-cream/70 hover:text-cream',
          ]}
        >
          {link.text}
        </a>
      ))}
    </nav>

    <button
      class="lg:hidden flex flex-col gap-1.5 p-2"
      id="mobile-menu-toggle"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <span class="block w-6 h-0.5 bg-cream transition-all duration-300" id="bar1"></span>
      <span class="block w-6 h-0.5 bg-cream transition-all duration-300" id="bar2"></span>
      <span class="block w-6 h-0.5 bg-cream transition-all duration-300" id="bar3"></span>
    </button>
  </div>

  <div class="lg:hidden hidden fixed inset-0 bg-black/98 z-[60]" id="mobile-menu">
    <div class="flex flex-col items-center justify-center h-full gap-8">
      {NAV_LINKS.map((link) => (
        <a
          href={link.href}
          class:list={[
            'text-2xl font-heading font-bold transition-colors',
            currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
              ? 'text-red'
              : 'text-cream hover:text-red',
          ]}
        >
          {link.text}
        </a>
      ))}
    </div>
  </div>
</header>

<div class="h-20"></div>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const bar1 = document.getElementById('bar1');
  const bar2 = document.getElementById('bar2');
  const bar3 = document.getElementById('bar3');
  let isOpen = false;

  // Scroll behavior
  let lastScroll = 0;
  window.addEventListener('scroll', () => {
    const currentScroll = window.scrollY;
    if (header) {
      if (currentScroll > 80) {
        header.style.backgroundColor = 'rgba(10, 10, 10, 0.95)';
        header.style.backdropFilter = 'blur(12px)';
      } else {
        header.style.backgroundColor = 'transparent';
        header.style.backdropFilter = 'none';
      }
      if (currentScroll > lastScroll && currentScroll > 200) {
        header.style.transform = 'translateY(-100%)';
      } else {
        header.style.transform = 'translateY(0)';
      }
    }
    lastScroll = currentScroll;
  });

  // Mobile menu toggle
  toggle?.addEventListener('click', () => {
    isOpen = !isOpen;
    toggle.setAttribute('aria-expanded', String(isOpen));
    mobileMenu?.classList.toggle('hidden');
    document.body.style.overflow = isOpen ? 'hidden' : '';

    if (isOpen) {
      if (bar1) { bar1.style.transform = 'rotate(45deg) translate(4px, 4px)'; }
      if (bar2) { bar2.style.opacity = '0'; }
      if (bar3) { bar3.style.transform = 'rotate(-45deg) translate(4px, -4px)'; }
    } else {
      if (bar1) { bar1.style.transform = 'none'; }
      if (bar2) { bar2.style.opacity = '1'; }
      if (bar3) { bar3.style.transform = 'none'; }
    }
  });

  // Close mobile menu on link click
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      isOpen = false;
      mobileMenu.classList.add('hidden');
      document.body.style.overflow = '';
      if (bar1) { bar1.style.transform = 'none'; }
      if (bar2) { bar2.style.opacity = '1'; }
      if (bar3) { bar3.style.transform = 'none'; }
    });
  });
</script>
