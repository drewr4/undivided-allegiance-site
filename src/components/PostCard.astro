---
interface Props {
  title: string;
  excerpt?: string;
  date: Date;
  category: string;
  slug: string;
}

const { title, excerpt, date, category, slug } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="group">
  <a href={`/blog/${slug}/`} class="block no-underline">
    <div class="mb-3 flex items-center gap-3">
      <span class="font-display text-xs font-semibold uppercase tracking-widest text-[var(--color-warm-gray)]">
        {category}
      </span>
      <span class="text-[var(--color-border)]">&middot;</span>
      <time datetime={date.toISOString()} class="text-xs text-[var(--color-warm-gray)]">
        {formattedDate}
      </time>
    </div>
    <h3 class="font-display text-xl font-bold leading-tight text-[var(--color-ink)] transition-colors group-hover:text-[var(--color-charcoal-light)] md:text-2xl">
      {title}
    </h3>
    {excerpt && (
      <p class="mt-3 text-sm leading-relaxed text-[var(--color-charcoal-light)]">
        {excerpt}
      </p>
    )}
    <span class="mt-4 inline-block font-display text-xs font-semibold uppercase tracking-widest text-[var(--color-warm-gray)] transition-colors group-hover:text-[var(--color-ink)]">
      Read More &rarr;
    </span>
  </a>
</article>
