---
interface Props {
  title: string;
  excerpt?: string;
  slug: string;
  publishDate: Date;
  category: string;
}

const { title, excerpt, slug, publishDate, category } = Astro.props;

const formattedDate = publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="group bg-charcoal border border-cream/5 hover:border-cream/15 transition-all duration-300">
  <a href={`/blog/${slug}/`} class="block p-8">
    <div class="flex items-center gap-3 mb-4">
      <span class="text-red text-xs font-semibold uppercase tracking-widest">{category}</span>
      <span class="text-muted/50">·</span>
      <time class="text-muted text-xs" datetime={publishDate.toISOString()}>{formattedDate}</time>
    </div>

    <h3 class="text-xl font-heading font-bold text-cream group-hover:text-red transition-colors duration-200 mb-3 leading-tight">
      {title}
    </h3>

    {excerpt && (
      <p class="text-muted text-sm leading-relaxed line-clamp-3">
        {excerpt}
      </p>
    )}

    <div class="mt-6 flex items-center gap-2 text-red text-sm font-semibold uppercase tracking-wider">
      <span>Read</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transform group-hover:translate-x-1 transition-transform">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </div>
  </a>
</article>
