---
import { SITE, NAV_LINKS, SOCIAL_LINKS } from '../data/site-config';
import SocialIcon from './SocialIcon.astro';
---

<footer class="bg-charcoal border-t border-cream/5">
  <div class="container mx-auto px-6">
    <div class="py-16 grid grid-cols-1 md:grid-cols-3 gap-12">
      <div>
        <a href="/" class="font-heading text-2xl font-bold text-cream">{SITE.title}</a>
        <p class="mt-4 text-muted text-sm leading-relaxed max-w-xs">
          {SITE.description}
        </p>
        <div class="flex items-center gap-4 mt-6">
          {SOCIAL_LINKS.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-muted hover:text-cream transition-colors"
              aria-label={link.platform}
            >
              <SocialIcon icon={link.icon} size={18} />
            </a>
          ))}
        </div>
      </div>

      <div>
        <h4 class="text-sm font-semibold uppercase tracking-widest text-cream mb-6">Navigate</h4>
        <nav class="flex flex-col gap-3">
          {NAV_LINKS.map((link) => (
            <a href={link.href} class="text-muted text-sm hover:text-cream transition-colors">
              {link.text}
            </a>
          ))}
        </nav>
      </div>

      <div>
        <h4 class="text-sm font-semibold uppercase tracking-widest text-cream mb-6">Stay Connected</h4>
        <p class="text-muted text-sm leading-relaxed mb-4">
          Join the Remnant: a bi-weekly newsletter holding today's issues up to the lens of Scripture.
        </p>
        <form class="flex gap-2" data-email-form>
          <input
            type="email"
            placeholder="Your email"
            required
            class="flex-1 px-4 py-2.5 bg-black border border-cream/10 text-cream text-sm placeholder:text-muted focus:outline-none focus:border-red transition-colors"
          />
          <button type="submit" class="px-5 py-2.5 bg-red text-cream text-sm font-semibold uppercase tracking-wider hover:bg-red-light transition-colors">
            Join
          </button>
        </form>
      </div>
    </div>

    <div class="py-6 border-t border-cream/5 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-muted text-xs">
        &copy; {new Date().getFullYear()} {SITE.title}. All rights reserved.
      </p>
      <p class="text-muted text-xs">
        By {SITE.author}
      </p>
    </div>
  </div>
</footer>
