---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  excerpt?: string;
  publishDate: Date;
  updatedDate?: Date;
  category: string;
  tags: string[];
  image?: { src: string; alt: string; portrait?: boolean };
}

const { title, excerpt, publishDate, updatedDate, category, tags, image } = Astro.props;

const formattedDate = publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdatedDate = updatedDate?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title} description={excerpt} ogType="article" ogImage={image?.src}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": title,
    "description": excerpt || "",
    "datePublished": publishDate.toISOString(),
    ...(updatedDate && { "dateModified": updatedDate.toISOString() }),
    "image": image ? {
      "@type": "ImageObject",
      "url": `https://www.undividedallegiance.com${image.src}`,
      "width": 1200,
      "height": 630
    } : {
      "@type": "ImageObject",
      "url": "https://www.undividedallegiance.com/og-book.png",
      "width": 1931,
      "height": 2775
    },
    "author": {
      "@type": "Person",
      "name": "Drew Reitzel",
      "url": "https://www.undividedallegiance.com/about/"
    },
    "publisher": {
      "@type": "Organization",
      "name": "Undivided Allegiance",
      "url": "https://www.undividedallegiance.com"
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": `https://www.undividedallegiance.com${Astro.url.pathname}`
    },
    "keywords": tags
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.undividedallegiance.com/" },
      { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://www.undividedallegiance.com/blog/" },
      { "@type": "ListItem", "position": 3, "name": title, "item": `https://www.undividedallegiance.com${Astro.url.pathname}` }
    ]
  })} />
  <article class="section-padding">
    <div class="container-narrow">
      <header class="mb-16">
        <div class="flex items-center gap-4 mb-6">
          <span class="text-red uppercase text-sm font-semibold tracking-widest">{category}</span>
          <span class="text-muted">·</span>
          <time class="text-muted text-sm" datetime={publishDate.toISOString()}>{formattedDate}</time>
        </div>
        <h1 class="mb-6">{title}</h1>
        {excerpt && <p class="text-xl text-muted-light leading-relaxed">{excerpt}</p>}
        {updatedDate && (
          <p class="text-sm text-muted mt-4">Updated {formattedUpdatedDate}</p>
        )}
        <div class="divider mt-8"></div>
      </header>

      {image && (
        <div class={`mb-12${image.portrait ? ' flex justify-center' : ''}`}>
          <img
            src={image.src}
            alt={image.alt}
            width={image.portrait ? 836 : 1200}
            height={image.portrait ? 1152 : 630}
            class={image.portrait ? 'w-full max-w-md' : 'w-full'}
            loading="eager"
            decoding="async"
          />
        </div>
      )}

      <div class="prose-custom">
        <slot />
      </div>

      {tags.length > 0 && (
        <footer class="mt-16 pt-8 border-t border-charcoal">
          <div class="flex flex-wrap gap-3">
            {tags.map((tag) => (
              <span class="px-4 py-1.5 bg-charcoal text-muted text-sm rounded-sm">{tag}</span>
            ))}
          </div>
        </footer>
      )}

      <div class="author-bio mt-16 pt-10 border-t border-charcoal flex items-start gap-6">
        <picture>
          <source srcset="/assets/authors/drew-reitzel.webp" type="image/webp" />
          <img
            src="/assets/authors/drew-reitzel.jpg"
            alt="Drew Reitzel, author of You Can't Serve Two Masters and founder of Undivided Allegiance"
            width="96"
            height="96"
            loading="lazy"
            decoding="async"
          />
        </picture>
        <div>
          <p class="text-cream font-semibold mb-1">Drew Reitzel</p>
          <p class="text-muted text-sm leading-relaxed">Drew Reitzel is the author of <em>You Can't Serve Two Masters</em> and founder of Undivided Allegiance. His writing focuses on Scripture, divided allegiance, conviction, cultural compromise, repentance, and the call for Christians to live under the authority of Christ with clarity and unwavering loyalty.</p>
          <a href="/about/" class="text-red text-sm mt-2 inline-block hover:underline">More about Drew</a>
        </div>
      </div>

      <div class="mt-12">
        <a href="/blog/" class="btn-secondary inline-flex items-center gap-2">
          <span>&larr;</span> Back to Blog
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
