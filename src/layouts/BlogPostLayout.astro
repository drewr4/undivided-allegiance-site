---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  excerpt?: string;
  publishDate: Date;
  updatedDate?: Date;
  category: string;
  tags: string[];
}

const { title, excerpt, publishDate, updatedDate, category, tags } = Astro.props;

const formattedDate = publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdatedDate = updatedDate?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title} description={excerpt}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": title,
    "description": excerpt || "",
    "datePublished": publishDate.toISOString(),
    ...(updatedDate && { "dateModified": updatedDate.toISOString() }),
    "image": {
      "@type": "ImageObject",
      "url": "https://www.undividedallegiance.com/og-book.png",
      "width": 1931,
      "height": 2775
    },
    "author": {
      "@type": "Person",
      "name": "Drew Reitzel",
      "url": "https://www.undividedallegiance.com/about/"
    },
    "publisher": {
      "@type": "Organization",
      "name": "Undivided Allegiance",
      "url": "https://www.undividedallegiance.com"
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": `https://www.undividedallegiance.com${Astro.url.pathname}`
    },
    "keywords": tags
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.undividedallegiance.com/" },
      { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://www.undividedallegiance.com/blog/" },
      { "@type": "ListItem", "position": 3, "name": title, "item": `https://www.undividedallegiance.com${Astro.url.pathname}` }
    ]
  })} />
  <article class="section-padding">
    <div class="container-narrow">
      <header class="mb-16">
        <div class="flex items-center gap-4 mb-6">
          <span class="text-red uppercase text-sm font-semibold tracking-widest">{category}</span>
          <span class="text-muted">·</span>
          <time class="text-muted text-sm" datetime={publishDate.toISOString()}>{formattedDate}</time>
        </div>
        <h1 class="mb-6">{title}</h1>
        {excerpt && <p class="text-xl text-muted-light leading-relaxed">{excerpt}</p>}
        {updatedDate && (
          <p class="text-sm text-muted mt-4">Updated {formattedUpdatedDate}</p>
        )}
        <div class="divider mt-8"></div>
      </header>

      <div class="prose-custom">
        <slot />
      </div>

      {tags.length > 0 && (
        <footer class="mt-16 pt-8 border-t border-charcoal">
          <div class="flex flex-wrap gap-3">
            {tags.map((tag) => (
              <span class="px-4 py-1.5 bg-charcoal text-muted text-sm rounded-sm">{tag}</span>
            ))}
          </div>
        </footer>
      )}

      <div class="mt-16 pt-10 border-t border-charcoal flex items-start gap-6">
        <div class="shrink-0 w-14 h-14 rounded-full bg-charcoal flex items-center justify-center text-cream font-bold text-lg">DR</div>
        <div>
          <p class="text-cream font-semibold mb-1">Drew Reitzel</p>
          <p class="text-muted text-sm leading-relaxed">Drew holds a theology degree and spent 25 years in business before returning to writing and speaking. He is the author of <em>You Can't Serve Two Masters</em> and the founder of Undivided Allegiance.</p>
          <a href="/about/" class="text-red text-sm mt-2 inline-block hover:underline">More about Drew</a>
        </div>
      </div>

      <div class="mt-12">
        <a href="/blog/" class="btn-secondary inline-flex items-center gap-2">
          <span>&larr;</span> Back to Blog
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
