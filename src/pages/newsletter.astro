---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Newsletter" description="The Remnant — a bi-weekly letter for Christians who refuse to trade conviction for comfort.">
  <section class="section-padding bg-black">
    <div class="container mx-auto px-6 text-center max-w-2xl">
      <div class="fade-in">
        <span class="text-red text-sm font-semibold uppercase tracking-[0.2em] block mb-6">Newsletter</span>
        <h1 class="mb-6">The Remnant</h1>
        <div class="divider mx-auto mb-8"></div>
        <p class="text-muted-light text-lg leading-relaxed mb-10">
          A bi-weekly letter for Christians who refuse to trade conviction for comfort.
        </p>
        <div class="flex justify-center">
          <div style="background: #0A0A0A;">
            <script async src="https://subscribe-forms.beehiiv.com/embed.js"></script>
            <iframe src="https://subscribe-forms.beehiiv.com/c3ad021c-2a0f-40d3-9b52-2058dd05b6a5" class="beehiiv-embed" data-test-id="beehiiv-embed" frameborder="0" scrolling="no" style="width: 560px; height: 291px; margin: 0; border-radius: 0px 0px 0px 0px !important; background-color: transparent; box-shadow: 0 0 #0000; max-width: 100%;"></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
