---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getSortedPosts, getCategories } from '../../utils/content';

const posts = await getSortedPosts();
const categories = await getCategories();
---

<BaseLayout title="Faith and Culture Essays" description="Essays by Drew Reitzel on divided allegiance, cultural compromise, repentance, and what Scripture asks of the American Church today.">
  <!-- Hero -->
  <section class="section-padding bg-black">
    <div class="container mx-auto px-6 max-w-4xl">
      <div class="fade-in">
        <span class="text-red text-sm font-semibold uppercase tracking-[0.2em] block mb-6">Blog</span>
        <h1 class="mb-6">Writing for the Remnant</h1>
        <div class="divider mb-6"></div>
        <p class="text-muted-light text-xl leading-relaxed max-w-2xl">
          Essays that hold today's church and culture up to Scripture, and always end at the way home.
        </p>
      </div>
    </div>
  </section>

  <!-- Posts -->
  <section class="section-padding bg-charcoal">
    <div class="container mx-auto px-6">
      {categories.length > 1 && (
        <div class="flex flex-wrap gap-3 mb-12 fade-in">
          <button class="px-4 py-2 text-sm font-semibold uppercase tracking-wider bg-red text-cream category-filter active" data-category="all">
            All
          </button>
          {categories.map((category) => (
            <button class="px-4 py-2 text-sm font-semibold uppercase tracking-wider bg-charcoal text-muted hover:text-cream transition-colors category-filter" data-category={category}>
              {category}
            </button>
          ))}
        </div>
      )}

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="blog-grid">
        {posts.map((post) => (
          <div class="fade-in" data-post-category={post.data.category}>
            <BlogCard
              title={post.data.title}
              excerpt={post.data.excerpt}
              slug={post.id}
              publishDate={post.data.publishDate}
              category={post.data.category}
            />
          </div>
        ))}
      </div>

      {posts.length === 0 && (
        <div class="text-center py-20">
          <p class="text-muted text-lg">New content coming soon.</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  const filters = document.querySelectorAll('.category-filter');
  const posts = document.querySelectorAll('[data-post-category]');

  filters.forEach((filter) => {
    filter.addEventListener('click', () => {
      const category = filter.getAttribute('data-category');

      filters.forEach((f) => {
        f.classList.remove('bg-red', 'text-cream', 'active');
        f.classList.add('bg-charcoal', 'text-muted');
      });
      filter.classList.remove('bg-charcoal', 'text-muted');
      filter.classList.add('bg-red', 'text-cream', 'active');

      posts.forEach((post) => {
        const postCategory = post.getAttribute('data-post-category');
        if (category === 'all' || postCategory === category) {
          (post as HTMLElement).style.display = '';
        } else {
          (post as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
