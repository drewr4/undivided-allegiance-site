---
import BaseLayout from '../layouts/BaseLayout.astro';

const episodes = [
  {
    number: 1,
    title: 'Why the Church Chose Comfort Over Truth',
    description: 'In the pilot episode, we examine how the American Church systematically traded biblical authority for cultural relevance — and why naming it matters.',
    date: 'Coming Soon',
  },
  {
    number: 2,
    title: 'The Sin We Renamed',
    description: 'How softening the language of sin has not made the Church more compassionate — it has made it less honest.',
    date: 'Coming Soon',
  },
  {
    number: 3,
    title: 'What the Remnant Owes the World',
    description: 'Faithfulness is not retreat. The remnant has a responsibility — not to be popular, but to be present.',
    date: 'Coming Soon',
  },
];
---

<BaseLayout title="Podcast" description="The Undivided Allegiance podcast — prophetic conversations on faith, culture, and biblical fidelity.">
  <!-- Hero -->
  <section class="section-padding bg-black h-[70vh] flex items-center">
    <div class="container mx-auto px-6 max-w-4xl">
      <div class="fade-in">
        <span class="text-red text-sm font-semibold uppercase tracking-[0.2em] block mb-6">Podcast</span>
        <h1 class="mb-6">The Undivided Allegiance Podcast</h1>
        <div class="divider mb-6"></div>
        <p class="text-muted-light text-xl leading-relaxed max-w-2xl">
          Conversations for the remnant. Unfiltered. Uncompromising.
          Rooted in Scripture. Spoken in love.
        </p>
      </div>
    </div>
  </section>

  <!-- Subscribe -->
  <section class="py-8 bg-charcoal border-y border-cream/5">
    <div class="container mx-auto px-6">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
        <p class="text-cream font-semibold">Subscribe wherever you listen:</p>
        <div class="flex flex-wrap gap-4">
          {['Apple Podcasts', 'Spotify', 'YouTube'].map((platform) => (
            <span class="px-5 py-2 bg-black border border-cream/10 text-muted text-sm">
              {platform} — Coming Soon
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Episodes -->
  <section class="section-padding bg-black">
    <div class="container mx-auto px-6 max-w-4xl">
      <h2 class="mb-12 fade-in">Episodes</h2>
      <div class="space-y-6">
        {episodes.map((episode) => (
          <article class="bg-charcoal border border-cream/5 p-8 fade-in">
            <div class="flex items-start gap-6">
              <div class="flex-shrink-0 w-14 h-14 bg-red/10 border border-red/20 flex items-center justify-center">
                <span class="text-red font-heading text-xl font-bold">{episode.number}</span>
              </div>
              <div class="flex-1">
                <div class="flex items-center gap-3 mb-2">
                  <span class="text-muted text-xs uppercase tracking-wider">{episode.date}</span>
                </div>
                <h3 class="text-xl mb-3">{episode.title}</h3>
                <p class="text-muted leading-relaxed">{episode.description}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
