---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Speaking" description="Book Drew Reitzel for your church, conference, or event. Prophetic teaching on faith, culture, and biblical fidelity.">
  <!-- Hero -->
  <section class="py-16 md:py-20 bg-black">
    <div class="container mx-auto px-6 max-w-4xl">
      <div class="fade-in">
        <span class="text-red text-sm font-semibold uppercase tracking-[0.2em] block mb-6">Speaking</span>
        <h1 class="mb-6">Bring the Message to Your Community</h1>
        <div class="divider mb-6"></div>
        <p class="text-muted-light text-xl leading-relaxed max-w-2xl">
          Drew is available for churches, conferences, retreats, and events
          where biblical truth is the standard — not the exception.
        </p>
      </div>
    </div>
  </section>

  <!-- Topics -->
  <section class="section-padding bg-charcoal">
    <div class="container mx-auto px-6 max-w-4xl fade-in">
      <h2 class="mb-4">Speaking Topics</h2>
      <div class="divider mb-12"></div>
      <div class="space-y-8">
        {[
          {
            title: 'The Church Is Choosing',
            description: 'Why the American Church\'s departure from biblical truth is not accidental — and what it will take to return.',
          },
          {
            title: 'You Can\'t Serve Two Masters',
            description: 'The cost of cultural compromise and the call to undivided allegiance to Christ.',
          },
          {
            title: 'The Remnant\'s Responsibility',
            description: 'What it means to hold the line when the institution will not — and why faithfulness matters more than numbers.',
          },
          {
            title: 'Prophetic Courage in a Comfortable Church',
            description: 'Recovering the voice the Church has silenced and the message the world needs to hear.',
          },
        ].map((topic) => (
          <div class="p-8 bg-black border-l-2 border-red">
            <h3 class="text-xl mb-3">{topic.title}</h3>
            <p class="text-muted leading-relaxed">{topic.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Inquiry Form -->
  <section class="section-padding bg-black">
    <div class="container mx-auto px-6 max-w-2xl fade-in">
      <h2 class="text-center mb-4">Request Drew to Speak</h2>
      <div class="divider mx-auto mb-12"></div>

      <form class="space-y-6" data-speaking-form>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label class="block text-sm text-muted uppercase tracking-wider mb-2">Name</label>
            <input
              type="text"
              name="name"
              required
              class="w-full px-4 py-3 bg-charcoal border border-cream/10 text-cream placeholder:text-muted focus:outline-none focus:border-red transition-colors"
            />
          </div>
          <div>
            <label class="block text-sm text-muted uppercase tracking-wider mb-2">Email</label>
            <input
              type="email"
              name="email"
              required
              class="w-full px-4 py-3 bg-charcoal border border-cream/10 text-cream placeholder:text-muted focus:outline-none focus:border-red transition-colors"
            />
          </div>
        </div>

        <div>
          <label class="block text-sm text-muted uppercase tracking-wider mb-2">Organization / Church</label>
          <input
            type="text"
            name="organization"
            class="w-full px-4 py-3 bg-charcoal border border-cream/10 text-cream placeholder:text-muted focus:outline-none focus:border-red transition-colors"
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label class="block text-sm text-muted uppercase tracking-wider mb-2">Event Type</label>
            <select name="event_type" class="w-full px-4 py-3 bg-charcoal border border-cream/10 text-cream focus:outline-none focus:border-red transition-colors">
              <option value="">Select type</option>
              <option value="church">Church Service</option>
              <option value="conference">Conference</option>
              <option value="retreat">Retreat</option>
              <option value="seminar">Seminar</option>
              <option value="other">Other</option>
            </select>
          </div>
          <div>
            <label class="block text-sm text-muted uppercase tracking-wider mb-2">Preferred Date</label>
            <input
              type="date"
              name="date"
              class="w-full px-4 py-3 bg-charcoal border border-cream/10 text-cream focus:outline-none focus:border-red transition-colors"
            />
          </div>
        </div>

        <div>
          <label class="block text-sm text-muted uppercase tracking-wider mb-2">Message</label>
          <textarea
            name="message"
            rows="5"
            class="w-full px-4 py-3 bg-charcoal border border-cream/10 text-cream placeholder:text-muted focus:outline-none focus:border-red transition-colors resize-none"
            placeholder="Tell us about your event..."
          ></textarea>
        </div>

        <button type="submit" class="btn-primary w-full justify-center">
          Submit Inquiry
        </button>
      </form>
    </div>
  </section>
</BaseLayout>
