---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="Get in touch with Undivided Allegiance. For speaking inquiries, partnerships, or just to connect.">
  <!-- Hero -->
  <section class="py-16 md:py-20 bg-black">
    <div class="container mx-auto px-6 max-w-4xl">
      <div class="fade-in">
        <span class="text-red text-sm font-semibold uppercase tracking-[0.2em] block mb-6">Contact</span>
        <h1 class="mb-6">Get in Touch</h1>
        <div class="divider mb-6"></div>
        <p class="text-muted-light text-xl leading-relaxed max-w-2xl">
          Whether you have a question, a speaking inquiry, or simply want to connect —
          we would love to hear from you.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Form + Info -->
  <section class="section-padding bg-charcoal">
    <div class="container mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-16">
        <!-- Form -->
        <div class="lg:col-span-3 fade-in">
          <h2 class="text-2xl mb-8">Send a Message</h2>
          <form class="space-y-6" data-contact-form>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm text-muted uppercase tracking-wider mb-2">Name</label>
                <input
                  type="text"
                  name="name"
                  required
                  class="w-full px-4 py-3 bg-black border border-cream/10 text-cream placeholder:text-muted focus:outline-none focus:border-red transition-colors"
                />
              </div>
              <div>
                <label class="block text-sm text-muted uppercase tracking-wider mb-2">Email</label>
                <input
                  type="email"
                  name="email"
                  required
                  class="w-full px-4 py-3 bg-black border border-cream/10 text-cream placeholder:text-muted focus:outline-none focus:border-red transition-colors"
                />
              </div>
            </div>

            <div>
              <label class="block text-sm text-muted uppercase tracking-wider mb-2">Subject</label>
              <select name="subject" class="w-full px-4 py-3 bg-black border border-cream/10 text-cream focus:outline-none focus:border-red transition-colors">
                <option value="">Select a subject</option>
                <option value="general">General Inquiry</option>
                <option value="speaking">Speaking Request</option>
                <option value="media">Media / Interview</option>
                <option value="partnership">Partnership</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div>
              <label class="block text-sm text-muted uppercase tracking-wider mb-2">Message</label>
              <textarea
                name="message"
                rows="6"
                required
                class="w-full px-4 py-3 bg-black border border-cream/10 text-cream placeholder:text-muted focus:outline-none focus:border-red transition-colors resize-none"
                placeholder="What's on your mind?"
              ></textarea>
            </div>

            <button type="submit" class="btn-primary w-full sm:w-auto justify-center">
              Send Message
            </button>
          </form>
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-2 fade-in space-y-6">
          <div class="p-6 bg-black border border-cream/5">
            <h3 class="text-sm font-semibold uppercase tracking-widest text-muted mb-3">For Speaking Inquiries</h3>
            <p class="text-muted-light text-sm leading-relaxed mb-4">
              For event bookings and speaking engagements, please visit the
              dedicated speaking page for more details.
            </p>
            <a href="/speaking/" class="text-red text-sm font-semibold uppercase tracking-wider hover:text-red-light transition-colors">
              Speaking Page &rarr;
            </a>
          </div>

          <div class="p-6 bg-black border border-cream/5">
            <h3 class="text-sm font-semibold uppercase tracking-widest text-muted mb-3">Media &amp; Interviews</h3>
            <p class="text-muted-light text-sm leading-relaxed">
              For press inquiries, podcast interviews, or media requests,
              please use the contact form and select "Media / Interview"
              as the subject.
            </p>
          </div>

          <div class="p-6 bg-black border border-red/20">
            <h3 class="text-sm font-semibold uppercase tracking-widest text-red mb-4">The Book</h3>
            <p class="text-cream font-heading font-bold text-lg leading-snug mb-3">
              You Can't Serve Two Masters
            </p>
            <p class="text-muted-light text-sm leading-relaxed mb-4">
              A prophetic call to the American Church. Available April 30, 2026.
            </p>
            <a href="/book/" class="text-red text-sm font-semibold uppercase tracking-wider hover:text-red-light transition-colors">
              Learn More &rarr;
            </a>
          </div>

          <blockquote class="p-6 border-l-2 border-red/40">
            <p class="text-cream/70 italic text-base leading-relaxed mb-3">
              "The narrow gate is not locked. It is simply unpopular. That does not mean it is closed to you."
            </p>
            <cite class="text-muted text-xs uppercase tracking-[0.15em] not-italic">
              — Drew Reitzel
            </cite>
          </blockquote>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
