---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About" description="Learn about Drew Reitzel and the mission of Undivided Allegiance — calling the Church back to biblical fidelity.">
  <!-- Hero -->
  <section class="bg-black h-[70vh] flex items-center px-6">
    <div class="container mx-auto px-6 max-w-4xl">
      <div class="fade-in">
        <span class="text-red text-sm font-semibold uppercase tracking-[0.2em] block mb-6">About</span>
        <h1 class="mb-8">The Voice Behind the Message</h1>
        <div class="divider mb-8"></div>
      </div>
    </div>
  </section>

  <!-- Bio -->
  <section class="section-padding bg-charcoal">
    <div class="container mx-auto px-6 max-w-4xl">
      <div class="fade-in">
        <h2 class="text-3xl mb-8">Drew Reitzel</h2>
        <div class="space-y-6 text-muted-light text-lg leading-relaxed">
          <p>
            Drew Reitzel is a prophetic writer and speaker whose work sits at the intersection
            of faith, culture, and biblical truth. His writing does not seek to be popular —
            it seeks to be faithful.
          </p>
          <p>
            In a time when the Church has learned to speak in softer tones to avoid offending
            the world, Drew writes with the conviction that truth spoken in love is never cruel —
            but silence in the face of compromise always is.
          </p>
          <p>
            His debut book, <em>You Can't Serve Two Masters</em>, examines the American Church's
            steady exchange of biblical authority for cultural approval. It is not a condemnation.
            It is a mirror — and a call to come home.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission -->
  <section class="section-padding bg-black">
    <div class="container mx-auto px-6 max-w-4xl">
      <div class="fade-in">
        <span class="text-red text-sm font-semibold uppercase tracking-[0.2em] block mb-4">The Mission</span>
        <h2 class="mb-8">Why Undivided Allegiance Exists</h2>
        <div class="divider mb-8"></div>
        <div class="space-y-6 text-muted-light text-lg leading-relaxed">
          <p>
            Undivided Allegiance exists for the remnant — the believers who sense that something
            has gone deeply wrong in the modern Church but struggle to find voices willing to
            name it clearly.
          </p>
          <p>
            This is not about being right. It is about being faithful. The darkness of the hour
            is real — but so is the light that refuses to go out.
          </p>
          <p>
            Every essay, every episode, every word published here serves one purpose: to call
            the Church back to the standard it was given and the God it was made for.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="section-padding bg-charcoal">
    <div class="container mx-auto px-6 max-w-4xl">
      <div class="fade-in">
        <h2 class="mb-12 text-center">What We Stand On</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {[
            { title: 'Biblical Authority', text: 'Scripture is not a suggestion. It is the immovable foundation on which everything else must be tested.' },
            { title: 'Prophetic Honesty', text: 'We speak what is true, not what is comfortable. Love without truth is sentimentality. Truth without love is cruelty.' },
            { title: 'Cultural Clarity', text: 'We name what the culture celebrates and what Scripture confronts — without apology and without malice.' },
            { title: 'Remnant Identity', text: 'This is for those who have counted the cost. The narrow road is narrow for a reason.' },
          ].map((value) => (
            <div class="p-8 border border-cream/5">
              <h3 class="text-xl mb-4 text-cream">{value.title}</h3>
              <p class="text-muted leading-relaxed">{value.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
