---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Video" description="Watch short-form video content from Undivided Allegiance on YouTube: reels, teaching, and prophetic messages.">
  <!-- Hero -->
  <section class="section-padding bg-black">
    <div class="container mx-auto px-6 max-w-4xl">
      <div class="fade-in">
        <span class="text-red text-sm font-semibold uppercase tracking-[0.2em] block mb-6">Video</span>
        <h1 class="mb-6">Watch</h1>
        <div class="divider mb-6"></div>
        <p class="text-muted-light text-xl leading-relaxed max-w-2xl">
          Short-form reels and teaching content on undivided allegiance to Christ. New videos released regularly on YouTube.
        </p>
        <a
          href="https://youtube.com/@UndividedAllegiance"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary mt-8 inline-flex"
        >
          Watch on YouTube
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
