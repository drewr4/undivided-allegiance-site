---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import bookCover from '../assets/book-cover.png';
---

<BaseLayout title="The Book" description="You Can't Serve Two Masters — a prophetic call to the American Church by Drew Reitzel.">
  <!-- Hero -->
  <section class="section-padding bg-black">
    <div class="container mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="flex justify-center lg:justify-start fade-in">
          <div class="relative">
            <div class="absolute -inset-6 bg-red/10 blur-3xl"></div>
            <Image
              src={bookCover}
              alt="You Can't Serve Two Masters — by Drew Reitzel"
              class="relative w-80 md:w-96 shadow-2xl"
              widths={[384, 512]}
              sizes="(max-width: 768px) 320px, 384px"
            />
          </div>
        </div>
        <div class="fade-in">
          <span class="text-red text-sm font-semibold uppercase tracking-[0.2em] block mb-4">The Book</span>
          <h1 class="mb-6">You Can't Serve Two Masters</h1>
          <div class="divider mb-6"></div>
          <p class="text-xl text-muted-light leading-relaxed mb-4">
            By Drew Reitzel
          </p>
          <p class="text-muted-light leading-relaxed mb-8">
            The American Church has made its choice. Slowly, deliberately, and with full knowledge,
            it has exchanged the authority of Scripture for the approval of culture.
            This book holds up a mirror — not to condemn, but to call the Church home.
          </p>
          <a
            href="https://amazon.com"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary"
          >
            Order on Amazon
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- What's Inside -->
  <section class="section-padding bg-charcoal">
    <div class="container mx-auto px-6 max-w-4xl fade-in">
      <h2 class="text-center mb-4">What This Book Confronts</h2>
      <div class="divider mx-auto mb-12"></div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {[
          { title: 'The Language of Drift', text: 'Why we comfort ourselves with passive language — and why it must stop.' },
          { title: 'The Cost of Comfort', text: 'How the pursuit of cultural acceptance has hollowed out the gospel.' },
          { title: 'The Silence of Leaders', text: 'What happens when shepherds choose safety over faithfulness.' },
          { title: 'The Remnant\'s Role', text: 'What it means to hold the line when the institution will not.' },
          { title: 'The Way Back', text: 'Repentance is always available. The door is never closed.' },
          { title: 'Undivided Allegiance', text: 'You cannot serve two masters. The call to choose — and choose well.' },
        ].map((chapter) => (
          <div class="p-6 border-l-2 border-red">
            <h3 class="text-lg mb-2 text-cream">{chapter.title}</h3>
            <p class="text-muted text-sm leading-relaxed">{chapter.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quote -->
  <section class="section-padding bg-black">
    <div class="container mx-auto px-6 text-center max-w-3xl fade-in">
      <blockquote>
        <p class="text-2xl md:text-3xl font-heading text-cream leading-snug italic mb-8">
          "The Church is not drifting. It is choosing. And the only question is whether it will choose differently."
        </p>
        <cite class="text-muted text-sm uppercase tracking-widest not-italic">— Drew Reitzel</cite>
      </blockquote>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding bg-charcoal text-center">
    <div class="container mx-auto px-6 max-w-2xl fade-in">
      <h2 class="mb-4">Ready to Read?</h2>
      <div class="divider mx-auto mb-6"></div>
      <p class="text-muted-light text-lg leading-relaxed mb-10">
        Available now on Amazon in paperback and Kindle.
      </p>
      <a
        href="https://amazon.com"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary"
      >
        Order Your Copy
      </a>
    </div>
  </section>
</BaseLayout>
