---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import EmailCapture from '@/components/EmailCapture.astro';
import bookCover from '@/assets/book-cover.png';
---

<BaseLayout
  title="You Can't Serve Two Masters"
  description="Undivided Allegiance to Christ in an Age of Cultural Compromise. A prophetic call to the American Church by Drew Reitzel."
>
  <!-- Book Hero -->
  <section class="px-6 py-20 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="grid items-center gap-16 md:grid-cols-2 lg:gap-24">
        <!-- Cover -->
        <div class="flex items-center justify-center">
          <Image
            src={bookCover}
            alt="You Can't Serve Two Masters by Drew Reitzel — book cover"
            class="w-full max-w-md shadow-2xl"
            widths={[400, 600, 800, 1000]}
            sizes="(max-width: 768px) 90vw, 450px"
          />
        </div>

        <!-- Info -->
        <div>
          <p class="font-display text-xs font-semibold uppercase tracking-widest text-[var(--color-red)]">
            Now Available
          </p>
          <h1 class="mt-4 font-display text-4xl font-bold tracking-tight md:text-5xl">
            You Can't Serve<br />Two Masters
          </h1>
          <p class="mt-2 text-lg italic text-[var(--color-charcoal-light)]">
            Undivided Allegiance to Christ in an Age of Cultural Compromise
          </p>
          <p class="mt-2 text-sm text-[var(--color-warm-gray)]">
            By Drew Reitzel &bull; ISBN 979-8-2786-09926
          </p>

          <div class="mt-8 flex flex-wrap gap-4">
            <a href="#" class="btn btn-red-filled">Order on Amazon</a>
            <a href="#" class="btn btn-red">Buy Direct</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Back Cover Description -->
  <section class="section-divider px-6 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <p class="section-heading" style="border-bottom-color: var(--color-red);">About the Book</p>
      <div class="mt-6 space-y-6 text-base leading-relaxed text-[var(--color-charcoal)]">
        <p>
          Something has gone wrong in the American Church — and most of us can feel it.
        </p>
        <p>
          We live in a time when the lines between biblical Christianity and cultural religion have become so blurred that many believers no longer know the difference. The gospel has been softened. Truth has become negotiable. And the call to take up our cross and follow Christ has been quietly replaced by a call to be comfortable, accepted, and affirmed.
        </p>
        <p>
          <em>You Can't Serve Two Masters</em> is a prophetic call to the Church to stop straddling the fence. Drawing from Scripture, cultural analysis, and raw personal conviction, Drew Reitzel walks through the ways the modern Church has compromised its witness — from the redefinition of love and tolerance, to the embrace of ideologies that stand in direct opposition to the Word of God.
        </p>
        <p>
          This is not a book about politics. It is not a book about culture wars. It is a book about allegiance — and whether the Church in America is willing to give hers fully to Christ, even when it costs everything.
        </p>

        <blockquote class="border-l-4 border-[var(--color-red)] pl-6 italic">
          <p>"No one can serve two masters. Either you will hate the one and love the other, or you will be devoted to the one and despise the other."</p>
          <cite class="mt-2 block text-sm not-italic text-[var(--color-warm-gray)]">— Matthew 6:24</cite>
        </blockquote>

        <p>
          If you have ever looked at the state of the Church and thought, <em>"This is not what it was supposed to be"</em> — this book was written for you.
        </p>
      </div>
    </div>
  </section>

  <!-- Endorsements -->
  <section class="section-divider px-6 lg:px-8">
    <div class="mx-auto max-w-5xl">
      <p class="section-heading text-center" style="border-bottom-color: var(--color-red);">What Others Are Saying</p>
      <div class="mt-8 grid gap-10 md:grid-cols-2">
        <div class="border-l-2 border-[var(--color-border)] pl-6">
          <p class="italic leading-relaxed text-[var(--color-charcoal)]">
            "A bold and necessary word for the American Church. Drew writes with the urgency of a prophet and the heart of a pastor."
          </p>
          <p class="mt-4 text-sm font-semibold text-[var(--color-ink)]">— Endorsement Placeholder</p>
        </div>
        <div class="border-l-2 border-[var(--color-border)] pl-6">
          <p class="italic leading-relaxed text-[var(--color-charcoal)]">
            "This is not a comfortable book — and that is exactly why the Church needs it. Reitzel holds nothing back."
          </p>
          <p class="mt-4 text-sm font-semibold text-[var(--color-ink)]">— Endorsement Placeholder</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="px-6 py-20 text-center lg:px-8">
    <div class="mx-auto max-w-2xl">
      <h2 class="font-display text-3xl font-bold md:text-4xl">
        Ready to Read?
      </h2>
      <p class="mt-4 text-[var(--color-charcoal-light)]">
        Order your copy today and join a growing movement of believers who refuse to divide their allegiance.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="#" class="btn btn-red-filled">Order on Amazon</a>
        <a href="#" class="btn btn-red">Buy Direct</a>
      </div>
    </div>
  </section>

  <EmailCapture heading="Get Book Updates" text="Be the first to hear about new releases, bulk ordering, and reading guides." />
</BaseLayout>
