---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import bookCover from '../assets/book-cover.png';
---

<BaseLayout title="You Can't Serve Two Masters" description="Undivided allegiance to Christ in an age of cultural compromise. A prophetic call to the American Church by Drew Reitzel.">
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Book",
    "name": "You Can't Serve Two Masters",
    "subtitle": "Undivided Allegiance to Christ in an Age of Cultural Compromise",
    "author": {
      "@type": "Person",
      "name": "Drew Reitzel",
      "url": "https://www.undividedallegiance.com/about/"
    },
    "isbn": "979-8-2786-09926",
    "bookFormat": ["https://schema.org/EBook", "https://schema.org/Paperback"],
    "numberOfPages": 250,
    "publisher": {
      "@type": "Organization",
      "name": "Undivided Allegiance"
    },
    "datePublished": "2026-04-30",
    "image": "https://www.undividedallegiance.com/_astro/book-cover.Bgaqth1X_Z1ixAoY.webp",
    "url": "https://www.undividedallegiance.com/book/",
    "offers": [
      {
        "@type": "Offer",
        "price": "9.99",
        "priceCurrency": "USD",
        "availability": "https://schema.org/PreOrder",
        "url": "https://www.amazon.com/dp/B0FGY9PL66",
        "itemCondition": "https://schema.org/NewCondition"
      },
      {
        "@type": "Offer",
        "price": "16.99",
        "priceCurrency": "USD",
        "availability": "https://schema.org/PreOrder",
        "itemCondition": "https://schema.org/NewCondition"
      }
    ],
    "genre": ["Religion", "Christianity", "Church"],
    "inLanguage": "en",
    "description": "A prophetic call to the American Church. Confronts the abortion altar, the redefinition of marriage, the silencing of the pulpit, and the cheap grace that has replaced the costly Gospel of Jesus Christ."
  })} />
  <!-- ViewContent pixel event — tells Meta + TikTok this visitor viewed the book page -->
  <script is:inline>
    fbq('track', 'ViewContent', {
      content_name: 'You Cant Serve Two Masters',
      content_type: 'product',
      value: 9.99,
      currency: 'USD'
    });
    if (typeof ttq !== 'undefined') {
      ttq.track('ViewContent', {
        content_name: 'You Cant Serve Two Masters',
        content_type: 'product',
        value: 9.99,
        currency: 'USD'
      });
    }
  </script>

  <!-- Hero -->
  <section class="section-padding bg-black">
    <div class="container mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
        <div class="flex justify-center fade-in">
          <div class="relative">
            <div class="absolute -inset-8 bg-red/8 blur-[60px]"></div>
            <Image
              src={bookCover}
              alt="You Can't Serve Two Masters — by Drew Reitzel"
              class="relative w-72 sm:w-80 md:w-96 shadow-2xl"
              widths={[320, 384, 512]}
              sizes="(max-width: 640px) 288px, (max-width: 768px) 320px, 384px"
            />
          </div>
        </div>
        <div class="text-center lg:text-left fade-in">
          <h1 class="text-4xl sm:text-5xl md:text-6xl font-heading font-bold uppercase tracking-[0.08em] text-cream leading-[1.05] mb-6">
            You Can't Serve Two Masters
          </h1>
          <div class="w-20 h-[2px] bg-red mx-auto lg:mx-0 mb-6"></div>
          <p class="text-sm sm:text-base uppercase tracking-[0.15em] text-cream/80 leading-relaxed mb-6 max-w-lg mx-auto lg:mx-0">
            Undivided Allegiance to Christ in an Age of Cultural Compromise
          </p>
          <p class="text-sm uppercase tracking-[0.2em] text-muted mb-10">
            Drew Reitzel
          </p>

          <!-- Option 1: Pre-order -->
          <a href="https://www.amazon.com/dp/B0FGY9PL66" target="_blank" rel="noopener noreferrer" onclick="fbq('track', 'AddToCart', {content_name: 'YCSTM Kindle Preorder', content_type: 'product', value: 9.99, currency: 'USD'}); if(typeof ttq!=='undefined'){ttq.track('AddToCart', {content_name: 'YCSTM Kindle Preorder', content_type: 'product', value: 9.99, currency: 'USD'});}" class="btn-primary text-lg px-8 py-4 inline-flex mb-3">
            Preorder on Kindle — $9.99
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M7 17L17 7M17 7H7M17 7v10"/>
            </svg>
          </a>
          <div class="mb-8 space-y-1">
            <p class="text-cream/80 text-base"><span class="text-red font-semibold">Kindle</span> — Preorder now. Delivered April 30, 2026.</p>
            <p class="text-cream/80 text-base"><span class="text-red font-semibold">Print</span> — Available April 30, 2026.</p>
          </div>

          <!-- Divider -->
          <div class="w-full h-[1px] bg-cream/10 mb-8"></div>

          <!-- Option 2: Free Preview -->
          <p class="text-sm uppercase tracking-[0.15em] text-muted mb-4">Not ready to commit? Read a free preview first.</p>
          <form id="preview-form" class="flex flex-col sm:flex-row gap-3 max-w-lg mx-auto lg:mx-0 mb-2" novalidate>
            <label for="preview-email" class="sr-only">Email address</label>
            <input
              id="preview-email"
              type="email"
              name="email"
              required
              placeholder="Your email address"
              class="flex-1 px-4 py-3 bg-black border border-cream/20 text-cream placeholder-muted focus:outline-none focus:border-red text-base"
              autocomplete="email"
            />
            <button
              type="submit"
              id="preview-submit"
              class="btn-secondary px-6 py-3 text-base whitespace-nowrap"
            >
              Get Free Preview
            </button>
          </form>
          <p id="preview-msg" class="text-sm text-red mb-2 hidden"></p>
          <p class="text-xs text-muted leading-relaxed max-w-lg mx-auto lg:mx-0">
            By submitting your email you will receive the free preview and be subscribed to The Remnant, our biweekly newsletter. Unsubscribe any time.
          </p>

          <blockquote class="mt-10 border-l-2 border-red/40 pl-6 max-w-lg mx-auto lg:mx-0">
            <p class="text-cream/70 italic text-base leading-relaxed mb-2">
              "This is the book the Church needs but fears to read. Every pastor in America should have a copy."
            </p>
            <cite class="text-muted text-xs uppercase tracking-[0.15em] not-italic">
              — John Dillon, Undivided Allegiance, Orlando, FL
            </cite>
          </blockquote>
        </div>
      </div>
    </div>
  </section>


  <script is:inline>
    (function () {
      var form = document.getElementById('preview-form');
      var emailInput = document.getElementById('preview-email');
      var submitBtn = document.getElementById('preview-submit');
      var msg = document.getElementById('preview-msg');
      if (!form) return;
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var email = emailInput.value.trim();
        if (!email || !email.includes('@')) {
          msg.textContent = 'Please enter a valid email address.';
          msg.classList.remove('hidden');
          return;
        }
        submitBtn.disabled = true;
        submitBtn.textContent = 'One moment...';
        if (typeof fbq !== 'undefined') {
          fbq('track', 'Lead', { content_name: 'Free Preview Download' });
        }
        if (typeof ttq !== 'undefined') {
          ttq.track('CompleteRegistration', { content_name: 'Free Preview Download' });
        }
        fetch('https://subscribe.drewreitzel.workers.dev', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email, source: 'book-preview' })
        })
          .then(function (res) { return res.json(); })
          .then(function (data) {
            if (data.already_subscribed) {
              msg.textContent = 'This email is already subscribed. Please use a different email address.';
              msg.classList.remove('hidden');
              submitBtn.disabled = false;
              submitBtn.textContent = 'Get Free Preview';
            } else {
              window.open('/free-preview.pdf', '_blank');
              emailInput.value = '';
              submitBtn.disabled = false;
              submitBtn.textContent = 'Get Free Preview';
              msg.classList.add('hidden');
            }
          })
          .catch(function () {
            window.open('/free-preview.pdf', '_blank');
            emailInput.value = '';
            submitBtn.disabled = false;
            submitBtn.textContent = 'Get Free Preview';
            msg.classList.add('hidden');
          });
      });
    })();
  </script>

  <!-- The Indictment -->
  <section class="section-padding bg-charcoal">
    <div class="container mx-auto px-6 max-w-3xl text-center fade-in">
      <blockquote class="mb-12">
        <p class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold text-cream leading-[1.15] italic">
          "The Church is not drifting.<br />It is choosing."
        </p>
      </blockquote>
      <div class="divider mx-auto mb-12"></div>
      <div class="text-left space-y-6 text-lg text-cream/80 leading-relaxed">
        <p>
          Choosing cultural approval over biblical fidelity. Choosing silence over conviction. Choosing the language of compassion while abandoning its source. And with every accommodation, every softened sermon, every redefinition of truth dressed up as love — the cost grows heavier and the distance from God grows wider.
        </p>
        <p class="text-cream font-semibold text-xl">
          This is not a book about politics. It is a book about allegiance.
        </p>
      </div>
    </div>
  </section>

  <!-- What This Book Confronts -->
  <section class="section-padding bg-black">
    <div class="container mx-auto px-6 max-w-3xl fade-in">
      <h2 class="text-center mb-4">What This Book Confronts</h2>
      <div class="divider mx-auto mb-12"></div>
      <div class="space-y-6 text-lg text-cream/80 leading-relaxed">
        <p>
          <em>You Can't Serve Two Masters</em> confronts the abortion altar, the redefinition of marriage, the silencing of the pulpit, and the cheap grace that has replaced the costly Gospel of Jesus Christ. It does not offer comfort. It offers truth — because truth, spoken in love, is the only thing that can still lead us back.
        </p>
        <p>
          God has not abandoned His people. But His people have wandered far. The watchman is sounding the alarm. The question is no longer whether judgment is coming. The question is whether you will hear it before it arrives.
        </p>
        <p class="text-cream font-semibold text-xl text-center pt-4">
          Repentance is not the end. It is the only way home.
        </p>
      </div>
    </div>
  </section>

  <!-- About the Author -->
  <section class="section-padding bg-charcoal">
    <div class="container mx-auto px-6 max-w-3xl fade-in">
      <span class="text-red text-sm font-semibold uppercase tracking-[0.2em] block mb-4 text-center">The Author</span>
      <h2 class="text-center mb-4">About Drew Reitzel</h2>
      <div class="divider mx-auto mb-12"></div>
      <div class="text-lg text-cream/80 leading-relaxed">
        <p>
          Drew Reitzel holds a degree in theology and served for several years in pastoral ministry before spending the last twenty-five years in the marketplace. He writes not from a distance but from the middle of the road — as someone who has known the mountaintop and the valley, who has carried his own cross, and who understands what it means to love God and still struggle to obey Him. This book was not written from a place of arrival. It was written from a place of conviction — by a man who has seen enough of his own failure to know that repentance is not theory, and enough of God's mercy to know that it is always available. His heart is for the Church, for the lost, and for a nation that still has time to turn.
        </p>
      </div>
    </div>
  </section>

  <!-- Preorder CTA -->
  <section class="section-padding bg-black text-center">
    <div class="container mx-auto px-6 max-w-2xl fade-in">
      <div class="w-20 h-[2px] bg-red mx-auto mb-8"></div>
      <h2 class="mb-6">Preorder Now</h2>
      <div class="mb-8 space-y-1">
        <p class="text-cream/80 text-lg"><span class="text-red font-semibold">Kindle</span> — Preorder now. Delivered April 30, 2026.</p>
        <p class="text-cream/80 text-lg"><span class="text-red font-semibold">Print</span> — Available April 30, 2026.</p>
      </div>
      <a href="https://www.amazon.com/dp/B0FGY9PL66" target="_blank" rel="noopener noreferrer" onclick="fbq('track', 'AddToCart', {content_name: 'YCSTM Kindle Preorder', content_type: 'product', value: 9.99, currency: 'USD'}); if(typeof ttq!=='undefined'){ttq.track('AddToCart', {content_name: 'YCSTM Kindle Preorder', content_type: 'product', value: 9.99, currency: 'USD'});}" class="btn-primary text-lg px-10 py-4 mb-12 inline-flex">
        Preorder on Kindle — $9.99
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M7 17L17 7M17 7H7M17 7v10"/>
        </svg>
      </a>
    </div>
  </section>

  <style>
    :global(body) {
      overflow-x: hidden;
    }
    section {
      overflow-x: hidden;
    }
    .btn-secondary {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background-color: transparent;
      border: 1px solid rgba(245, 240, 232, 0.3);
      color: rgb(245, 240, 232);
      font-family: var(--font-heading);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      transition: border-color 0.2s, color 0.2s;
    }
    .btn-secondary:hover {
      border-color: rgb(180, 30, 30);
      color: rgb(245, 240, 232);
    }
  </style>
</BaseLayout>
