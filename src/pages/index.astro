---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import EmailCapture from '@/components/EmailCapture.astro';
import { getSortedPosts } from '@/utils/content';
import bookCover from '@/assets/book-cover.png';

const posts = await getSortedPosts();
const latestPosts = posts.slice(0, 3);
---

<BaseLayout>
  <!-- Hero -->
  <section class="px-6 py-24 md:py-36 lg:px-8">
    <div class="mx-auto max-w-4xl text-center">
      <p class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-[var(--color-warm-gray)]">
        Drew Reitzel
      </p>
      <h1 class="mt-6 font-display text-4xl font-bold leading-[1.1] tracking-tight md:text-6xl lg:text-7xl">
        The Church is not drifting.<br />It is choosing.
      </h1>
      <p class="mx-auto mt-8 max-w-2xl text-lg leading-relaxed text-[var(--color-charcoal-light)]">
        Prophetic writer and speaker calling the Church back to biblical fidelity in an age of cultural compromise.
      </p>
      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="/book/" class="btn btn-filled">Explore the Book</a>
        <a href="/about/" class="btn">About Drew</a>
      </div>
    </div>
  </section>

  <!-- Featured Book -->
  <section class="section-divider px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <p class="section-heading">Featured Book</p>
      <div class="mt-2 grid items-center gap-12 md:grid-cols-2 lg:gap-20">
        <!-- Book cover -->
        <div class="flex items-center justify-center">
          <Image
            src={bookCover}
            alt="You Can't Serve Two Masters by Drew Reitzel — book cover"
            class="w-full max-w-sm shadow-xl"
            widths={[400, 600, 800]}
            sizes="(max-width: 768px) 90vw, 400px"
          />
        </div>

        <!-- Book info -->
        <div>
          <h2 class="font-display text-3xl font-bold leading-tight md:text-4xl">
            You Can't Serve<br />Two Masters
          </h2>
          <p class="mt-2 text-base italic text-[var(--color-charcoal-light)]">
            Undivided Allegiance to Christ in an Age of Cultural Compromise
          </p>
          <p class="mt-6 leading-relaxed text-[var(--color-charcoal)]">
            A prophetic call to the American Church to examine where it has traded biblical faithfulness for cultural acceptance. This is not a political book. It is a mirror — held up to a Church that has slowly learned to say "Lord, Lord" while living as though the world sets the terms.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="/book/" class="btn btn-red">Learn More</a>
            <a href="#" class="btn btn-red-filled">Order Now</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest Articles -->
  <section class="section-divider px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="flex items-end justify-between">
        <p class="section-heading">Latest Articles</p>
        <a href="/blog/" class="mb-8 font-display text-xs font-semibold uppercase tracking-widest text-[var(--color-warm-gray)] transition-colors hover:text-[var(--color-ink)]">
          View All &rarr;
        </a>
      </div>
      <div class="mt-2 grid gap-10 md:grid-cols-3 md:gap-12">
        {latestPosts.map(post => (
          <PostCard
            title={post.data.title}
            excerpt={post.data.excerpt}
            date={post.data.publishDate}
            category={post.data.category}
            slug={post.id}
          />
        ))}
      </div>
      {latestPosts.length === 0 && (
        <p class="py-12 text-center text-[var(--color-warm-gray)]">
          Articles coming soon.
        </p>
      )}
    </div>
  </section>

  <!-- Email Capture -->
  <div class="mt-20">
    <EmailCapture />
  </div>
</BaseLayout>
