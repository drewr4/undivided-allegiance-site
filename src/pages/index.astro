---
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoBackground from '../components/VideoBackground.astro';
import BlogCard from '../components/BlogCard.astro';
import EmailCapture from '../components/EmailCapture.astro';
import { Image } from 'astro:assets';
import bookCover from '../assets/book-cover.png';
import { getSortedPosts } from '../utils/content';

const posts = await getSortedPosts();
const latestPosts = posts.slice(0, 3);
---

<BaseLayout>
  <!-- Hero -->
  <section class="relative min-h-[90vh] flex items-center -mt-20">
    <VideoBackground overlay overlayOpacity={0.75} />
    <div class="relative z-10 container hp-container mx-auto px-6 py-32">
      <div class="max-w-3xl">
        <div class="divider mb-8"></div>
        <h1 class="hero-headline mb-6 text-cream">
          The Church is not drifting.<br />
          <span class="text-red">It is choosing.</span>
        </h1>
        <p class="text-xl md:text-2xl text-cream/70 leading-relaxed mb-10 max-w-xl font-light">
          This is not condemnation. It is a call home.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/book/" class="btn-primary">
            Order on Kindle — $9.99
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M7 17L17 7M17 7H7M17 7v10"/>
            </svg>
          </a>
          <a href="/book/" class="btn-secondary">
            Explore the Book
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission Statement -->
  <section class="section-padding bg-black">
    <div class="container hp-container mx-auto px-6 text-center max-w-4xl fade-in">
      <span class="text-red text-sm font-semibold uppercase tracking-[0.2em] block mb-6">The Mission</span>
      <h2 class="mission-heading mb-8">
        A prophetic voice calling the Church back to biblical fidelity
      </h2>
      <div class="divider mx-auto mb-8"></div>
      <p class="text-xl text-muted-light leading-relaxed max-w-2xl mx-auto">
        For the watchmen and women sounding the alarm while the world compromises.
        For those who refuse to look away. For the remnant that will not bow.
      </p>
    </div>
  </section>

  <!-- Featured Book -->
  <section class="section-padding bg-charcoal">
    <div class="container hp-container mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center fade-in">
        <div class="flex justify-center lg:justify-end">
          <div class="relative">
            <div class="absolute -inset-4 bg-red/10 blur-3xl"></div>
            <Image
              src={bookCover}
              alt="You Can't Serve Two Masters — by Drew Reitzel"
              class="relative w-72 md:w-80 shadow-2xl"
              widths={[320, 480]}
              sizes="(max-width: 768px) 288px, 320px"
            />
          </div>
        </div>
        <div>
          <span class="text-red text-sm font-semibold uppercase tracking-[0.2em] block mb-4">The Book</span>
          <h2 class="book-title mb-6">You Can't Serve Two Masters</h2>
          <div class="divider mb-6"></div>
          <p class="text-muted-light text-lg leading-relaxed mb-4">
            The American Church stands at a crossroads. It has traded the authority of Scripture
            for the approval of culture — and called it progress.
          </p>
          <p class="text-muted leading-relaxed mb-8">
            This book is not an attack on the Church. It is a mirror held up in love.
            A call to examine what we have accepted, what we have abandoned,
            and whether we are willing to return to the narrow road that Christ actually described.
          </p>
          <p class="available-date text-cream text-2xl uppercase tracking-[0.12em] font-bold mb-6">Available now on Kindle. $9.99. Print available May 2.</p>
          <a href="/book/" class="btn-secondary">
            Learn More
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest Content -->
  {latestPosts.length > 0 && (
    <section class="section-padding bg-black">
      <div class="container hp-container mx-auto px-6 fade-in">
        <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4 mb-12">
          <div>
            <span class="text-red text-sm font-semibold uppercase tracking-[0.2em] block mb-4">Latest</span>
            <h2>Recent Writing</h2>
          </div>
          <a href="/blog/" class="btn-secondary text-sm py-2 px-4">
            View All
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {latestPosts.map((post) => (
            <BlogCard
              title={post.data.title}
              excerpt={post.data.excerpt}
              slug={post.id}
              publishDate={post.data.publishDate}
              category={post.data.category}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Email Capture -->
  <EmailCapture heading="Join the Remnant" subtext="Prophetic writing delivered to those who refuse to look away. No spam. Unsubscribe anytime." />

  <!-- Homepage Popup -->
  <div id="popup-overlay" class="fixed inset-0 z-[9999] flex items-center justify-center p-4" style="background: rgba(10,10,10,0.88); display: none;">
    <div class="relative w-full max-w-lg p-8 sm:p-10" style="background-color: #F5F0E8;">
      <button id="popup-close" class="absolute top-4 right-4 transition-colors" style="color: rgba(10,10,10,0.4);" onmouseover="this.style.color='#0A0A0A'" onmouseout="this.style.color='rgba(10,10,10,0.4)'" aria-label="Close">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
      <div class="w-12 h-[2px] bg-red mb-6"></div>
      <h2 class="font-heading font-bold uppercase tracking-[0.1em] text-2xl sm:text-3xl mb-6" style="color: #0A0A0A;">Stand With Us</h2>
      <p class="text-sm leading-relaxed mb-4" style="color: rgba(10,10,10,0.75);">
        Join the Undivided Allegiance mailing list and receive articles on faith, culture, and what it means to follow Christ without compromise, new blog posts the moment they go live, and The Remnant newsletter, a prophetic perspective on the American Church delivered every other week.
      </p>
      <p class="text-sm leading-relaxed mb-6" style="color: rgba(10,10,10,0.75);">
        Also, receive a <strong style="color: #0A0A0A;">FREE</strong> preview of <em>You Can't Serve Two Masters</em> in digital format.
      </p>
      <p class="text-sm leading-relaxed mb-6" style="color: rgba(10,10,10,0.75);">
        The line has already been drawn. <strong style="color: #0A0A0A;">Stand With Us.</strong>
      </p>
      <form id="popup-form" novalidate>
        <label for="popup-name" class="sr-only">First name</label>
        <input
          id="popup-name"
          type="text"
          name="name"
          placeholder="First name"
          class="w-full px-4 py-3 text-base mb-3 focus:outline-none"
          style="background: #fff; border: 1px solid rgba(10,10,10,0.2); color: #0A0A0A;"
          autocomplete="given-name"
        />
        <label for="popup-email" class="sr-only">Email address</label>
        <input
          id="popup-email"
          type="email"
          name="email"
          required
          placeholder="Email address"
          class="w-full px-4 py-3 text-base mb-4 focus:outline-none"
          style="background: #fff; border: 1px solid rgba(10,10,10,0.2); color: #0A0A0A;"
          autocomplete="email"
        />
        <p id="popup-msg" class="text-sm text-red mb-3 hidden"></p>
        <button type="submit" id="popup-submit" class="btn-primary w-full justify-center py-3 text-base">
          Count Me In
        </button>
      </form>
      <p class="text-xs mt-4 leading-relaxed" style="color: rgba(10,10,10,0.45);">
        By submitting you agree to receive The Remnant newsletter and occasional updates. Unsubscribe any time.
      </p>
    </div>
  </div>

  <script is:inline>
    (function () {
      if (sessionStorage.getItem('ua_popup_seen')) return;
      var overlay = document.getElementById('popup-overlay');
      setTimeout(function () {
        sessionStorage.setItem('ua_popup_seen', '1');
        overlay.style.display = 'flex';
      }, 1500);
      var closeBtn = document.getElementById('popup-close');
      var form = document.getElementById('popup-form');
      var nameInput = document.getElementById('popup-name');
      var emailInput = document.getElementById('popup-email');
      var submitBtn = document.getElementById('popup-submit');
      var msg = document.getElementById('popup-msg');

      function closePopup() {
        overlay.style.display = 'none';
      }

      closeBtn.addEventListener('click', closePopup);
      overlay.addEventListener('click', function (e) {
        if (e.target === overlay) closePopup();
      });

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var email = emailInput.value.trim();
        var name = nameInput.value.trim();
        if (!email || !email.includes('@')) {
          msg.textContent = 'Please enter a valid email address.';
          msg.classList.remove('hidden');
          return;
        }
        submitBtn.disabled = true;
        submitBtn.textContent = 'One moment...';
        if (typeof fbq !== 'undefined') {
          fbq('track', 'Lead', { content_name: 'Homepage Popup Signup' });
        }
        if (typeof ttq !== 'undefined') {
          ttq.track('CompleteRegistration', { content_name: 'Homepage Popup Signup' });
        }
        fetch('https://subscribe.drewreitzel.workers.dev', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email, name: name, source: 'homepage-popup' })
        })
          .then(function (res) { return res.json(); })
          .then(function (data) {
            if (data.already_subscribed) {
              msg.textContent = 'This email is already subscribed. Please use a different email address.';
              msg.classList.remove('hidden');
              submitBtn.disabled = false;
              submitBtn.textContent = 'Count Me In';
            } else {
              window.open('/free-preview.pdf', '_blank');
              setTimeout(closePopup, 500);
            }
          })
          .catch(function () {
            window.open('/free-preview.pdf', '_blank');
            setTimeout(closePopup, 500);
          });
      });
    })();
  </script>
</BaseLayout>

<style>
  /* Mobile portrait — narrow vertical screens */
  @media (max-width: 768px) and (orientation: portrait) {
    .hero-headline {
      font-size: 1.75rem;
    }
    .mission-heading {
      font-size: 1.5rem;
    }
    .book-title {
      font-size: 1.5rem;
    }
    .available-date {
      font-size: 1rem;
      white-space: nowrap;
    }
    .hp-container {
      padding-left: 1rem !important;
      padding-right: 1rem !important;
    }
  }

  /* Mobile landscape — wider horizontal screens */
  @media (max-width: 768px) and (orientation: landscape) {
    .hero-headline {
      font-size: 2.25rem;
    }
    .mission-heading {
      font-size: 1.75rem;
    }
    .book-title {
      font-size: 1.75rem;
    }
    .available-date {
      font-size: 1.25rem;
      white-space: nowrap;
    }
  }
</style>
