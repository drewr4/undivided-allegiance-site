---
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoBackground from '../components/VideoBackground.astro';
import BlogCard from '../components/BlogCard.astro';
import EmailCapture from '../components/EmailCapture.astro';
import { Image } from 'astro:assets';
import bookCover from '../assets/book-cover.png';
import { getSortedPosts } from '../utils/content';

const posts = await getSortedPosts();
const latestPosts = posts.slice(0, 3);
---

<BaseLayout>
  <!-- Hero -->
  <section class="relative min-h-[90vh] flex items-center -mt-20">
    <VideoBackground overlay overlayOpacity={0.75} />
    <div class="relative z-10 container hp-container mx-auto px-6 py-32">
      <div class="max-w-3xl">
        <div class="divider mb-8"></div>
        <h1 class="hero-headline mb-6 text-cream">
          The Church is not drifting.<br />
          <span class="text-red">It is choosing.</span>
        </h1>
        <p class="text-xl md:text-2xl text-cream/70 leading-relaxed mb-10 max-w-xl font-light">
          This is not condemnation. It is a call home.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="https://www.amazon.com/dp/B0FGY9PL66" target="_blank" rel="noopener noreferrer" class="btn-primary">
            Preorder on Kindle — $9.99
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M7 17L17 7M17 7H7M17 7v10"/>
            </svg>
          </a>
          <a href="/book/" class="btn-secondary">
            Explore the Book
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission Statement -->
  <section class="section-padding bg-black">
    <div class="container hp-container mx-auto px-6 text-center max-w-4xl fade-in">
      <span class="text-red text-sm font-semibold uppercase tracking-[0.2em] block mb-6">The Mission</span>
      <h2 class="mission-heading mb-8">
        A prophetic voice calling the Church back to biblical fidelity
      </h2>
      <div class="divider mx-auto mb-8"></div>
      <p class="text-xl text-muted-light leading-relaxed max-w-2xl mx-auto">
        For the watchmen and women sounding the alarm while the world compromises.
        For those who refuse to look away. For the remnant that will not bow.
      </p>
    </div>
  </section>

  <!-- Featured Book -->
  <section class="section-padding bg-charcoal">
    <div class="container hp-container mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center fade-in">
        <div class="flex justify-center lg:justify-end">
          <div class="relative">
            <div class="absolute -inset-4 bg-red/10 blur-3xl"></div>
            <Image
              src={bookCover}
              alt="You Can't Serve Two Masters — by Drew Reitzel"
              class="relative w-72 md:w-80 shadow-2xl"
              widths={[320, 480]}
              sizes="(max-width: 768px) 288px, 320px"
            />
          </div>
        </div>
        <div>
          <span class="text-red text-sm font-semibold uppercase tracking-[0.2em] block mb-4">The Book</span>
          <h2 class="book-title mb-6">You Can't Serve Two Masters</h2>
          <div class="divider mb-6"></div>
          <p class="text-muted-light text-lg leading-relaxed mb-4">
            The American Church stands at a crossroads. It has traded the authority of Scripture
            for the approval of culture — and called it progress.
          </p>
          <p class="text-muted leading-relaxed mb-8">
            This book is not an attack on the Church. It is a mirror held up in love.
            A call to examine what we have accepted, what we have abandoned,
            and whether we are willing to return to the narrow road that Christ actually described.
          </p>
          <p class="available-date text-cream text-2xl uppercase tracking-[0.12em] font-bold mb-6">Available April 30, 2026</p>
          <a href="/book/" class="btn-secondary">
            Learn More
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest Content -->
  {latestPosts.length > 0 && (
    <section class="section-padding bg-black">
      <div class="container hp-container mx-auto px-6 fade-in">
        <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4 mb-12">
          <div>
            <span class="text-red text-sm font-semibold uppercase tracking-[0.2em] block mb-4">Latest</span>
            <h2>Recent Writing</h2>
          </div>
          <a href="/blog/" class="btn-secondary text-sm py-2 px-4">
            View All
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {latestPosts.map((post) => (
            <BlogCard
              title={post.data.title}
              excerpt={post.data.excerpt}
              slug={post.id}
              publishDate={post.data.publishDate}
              category={post.data.category}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Email Capture -->
  <EmailCapture heading="Join the Remnant" subtext="Prophetic writing delivered to those who refuse to look away. No spam. Unsubscribe anytime." />
</BaseLayout>

<style>
  /* Mobile portrait — narrow vertical screens */
  @media (max-width: 768px) and (orientation: portrait) {
    .hero-headline {
      font-size: 1.75rem;
    }
    .mission-heading {
      font-size: 1.5rem;
    }
    .book-title {
      font-size: 1.5rem;
    }
    .available-date {
      font-size: 1rem;
      white-space: nowrap;
    }
    .hp-container {
      padding-left: 1rem !important;
      padding-right: 1rem !important;
    }
  }

  /* Mobile landscape — wider horizontal screens */
  @media (max-width: 768px) and (orientation: landscape) {
    .hero-headline {
      font-size: 2.25rem;
    }
    .mission-heading {
      font-size: 1.75rem;
    }
    .book-title {
      font-size: 1.75rem;
    }
    .available-date {
      font-size: 1.25rem;
      white-space: nowrap;
    }
  }
</style>
